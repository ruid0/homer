# Copy to .env.local and adjust. Everything stays local: no cloud providers.

# API
PORT=3001
# Single SQLite file (the one thing to back up). Docker Compose overrides this to /data/homer.db
DATABASE_PATH=
# Address the app is reached at (your Tailscale or LAN URL)
PUBLIC_URL=

# Ollama (Docker Compose overrides this to the ollama service)
OLLAMA_HOST=http://127.0.0.1:11434
# Vision / OCR model
LOCAL_VISION_MODEL=qwen3-vl:8b
# Chat + tool-calling model
LOCAL_TEXT_MODEL=qwen3.5:9b
# Disable "thinking" on models that support it for faster, cleaner JSON
LOCAL_LLM_THINK=true
LOCAL_LLM_TIMEOUT_MS=300000

# Daily backups, dev only (Docker reads BACKUP_HOST_DIR and BACKUP_TIME from the shell or a root .env, see the README): folder and time (default ./backups and 06:00)
BACKUP_DIR=
BACKUP_TIME=

# When the daily job takes usage off item quantities (default 05:30). Docker: set it in the shell or a root .env.
DEPLETION_TIME=

# Notifications through ntfy. Off unless NTFY_HOUSEHOLD_TOPIC is set. In Docker these are read from .env.local.
# Use a long random topic name (the name is the only secret on the public server), for example: openssl rand -hex 16
NTFY_HOUSEHOLD_TOPIC=
# Default https://ntfy.sh. Point it at your own ntfy server to keep the text in the house.
NTFY_SERVER=
NTFY_TOKEN=
# Where tapping a notification opens HOMER (your Tailscale address).
HOMER_PUBLIC_URL=
# When the end-of-day note is sent (default 20:00). Docker: set it in the shell or a root .env, not .env.local.
END_OF_DAY_TIME=
