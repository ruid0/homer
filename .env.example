# Copy to .env.local and adjust. Everything stays local: no cloud providers.

# API
PORT=3001
# Single SQLite file (the one thing to back up). Docker Compose overrides this to /data/homer.db
DATABASE_PATH=
# Address the app is reached at (your Tailscale or LAN URL)
PUBLIC_URL=

# Ollama (Docker Compose overrides this to the ollama service)
OLLAMA_HOST=http://127.0.0.1:11434
# Vision / OCR model
LOCAL_VISION_MODEL=qwen3-vl:8b
# Chat + tool-calling model
LOCAL_TEXT_MODEL=qwen3.5:9b
# Disable "thinking" on models that support it for faster, cleaner JSON
LOCAL_LLM_THINK=true
LOCAL_LLM_TIMEOUT_MS=300000
